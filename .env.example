# Server environment: dev / prd
# no difference for now
SOLIS_ENV="prd"
# JWT keys
SOLIS_JWT_RSA_PRIV_KEY_PATH="./secrets/jwt-private.pem"
SOLIS_JWT_RSA_PUB_KEY_PATH="./secrets/jwt-public.pem"
SOLIS_JWT_HMAC_KEY="a_super_strong_key_string"
# gRPC TLS certificate
SOLIS_GRPC_CERT_PRIV_KEY_PATH="./secrets/grpc-private.pem"
SOLIS_GRPC_CERT_PUB_KEY_PATH="./secrets/grpc-public.pem"
# resource directory path
SOLIS_RESOURCE_DIR="./resources"
# config directory path
SOLIS_CONFIG_PATH="./config"
# admin API bearer auth string
SOLIS_ADMIN_AUTH="a_super_strong_token_string"
# server listening addr and ports
SOLIS_BIND_ADDRESS="127.0.0.1"
SOLIS_GRPC_PORT="50051"
SOLIS_HTTP_PORT="50052"
# database
SOLIS_DB_USERNAME='solis'
SOLIS_DB_PASSWORD='a_super_strong_password'
SOLIS_DB_HOST=localhost
SOLIS_DB_PORT=27017
SOLIS_DB_DATA_DIR="./data"
SOLIS_DB_REP_KEY_PATH="./secrets/keyfile"
# Log format
# 1: json
# 2: human-readable
SOLIS_LOG_TYPE="1"
# Game master database setting ID, only 1 entry in the official database for now
SOLIS_SETTING_ID="1"
